{
    "name": "qbit-321-253ny",
    "version": "0.0.1",
    "description": "Freeware open-source 321-253NY for MSFS",
    "edition": "stable",
    "imports": {
        "#build-utils": "./build-utils.js"
    },
    "scripts": {
        "====== Generic===========================================================": "========================================================",
        "build:cpp-wasm-cmake": "scripts/build-cmake.sh",
        "build:cpp-wasm-cmake-clean": "scripts/build-cmake.sh --clean",
        "build:cpp-wasm-cmake-debug": "scripts/build-cmake.sh --debug",
        "build:cpp-wasm-cmake-debug-clean": "scripts/build-cmake.sh --debug --clean",
        "build:cpp-wasm-cmake-test": "cd build-common/src/wasm/cpp-msfs-framework/test && ./test-cpp.sh", 
        "====== A321XLR =============================================================": "========================================================",
        "preparation:copy-base-package": "mkdir -p build-321xlr/out/qbitsim-aircraft-a321-253 && (rsync -a qbt-321xlr/src/base/qbitsim-aircraft-a321-253 build-321xlr/out/ || cp -a -u qbt-321xlr/src/base/qbitsim-aircraft-a321-253 build-321xlr/out/",
        "preparation:base-files": "npm run preparation:copy-base-package ",
        "preparation:enviroment": "npm run build:msfs-sdk",
        "build:behavior": "node build-321xlr/src/behavior/build.js",
        "build:atsu-common": "node build-321xlr/src/systems/atsu/common/build.js",
        "build:atsu-fms-client": "node build-321xlr/src/systems/atsu/fmsclient/build.js",
        "build:efb-translation": "cd build-common/src/systems/instruments/src/EFB/Localization && node build-flypad-translation.js",
        "build:locPak-translation": "cd build-321xlr/src/localization && node build-locPak-translation.js",
        "build:model": "node build-321xlr/src/model/buildv2.js && node build-321xlr/src/model/build.js",
        "build:msfs-sdk": "cd msfs-avionics-mirror/src/sdk && npm i && npm run build",
        "build:copy-cargo-config": "cp -rf Cargo-738.toml Cargo.toml",
        "build:copy-cmake-config": "cp -rf CMakeLists-738.txt CMakeLists.txt",
        "build:instruments": "mach build --config build-321xlr/mach.config.js --work-in-config-dir",
        "build:failures": "rollup -c build-321xlr/src/systems/failures/rollup.config.js",
        "build:fmgc": "node build-321xlr/src/systems/fmgc/build.js",
        "build:sentry-client": "node build-321xlr/src/systems/sentry-client/build.js",
        "build:simbridge-client": "node build-321xlr/src/systems/simbridge-client/build.js",
        "build:systems-host": "node build-321xlr/src/systems/systems-host/build.js",
        "build:extras-host": "node build-321xlr/src/systems/extras-host/build.js",
        "build:systems": "cargo build -p a320_systems_wasm --target wasm32-wasi --release && wasm-opt -O1 --signext-lowering --enable-bulk-memory -o /external/build-321xlr/out/qbitsim-aircraft-a321-253/SimObjects/AirPlanes/A321_XLR/panel/systems.wasm /external/target/wasm32-wasi/release/a320_systems_wasm.wasm",
        "build:metadata": "node scripts/metadata.js build-321xlr/out/qbitsim-aircraft-a321-253 RC1-V1",
        "build:manifest": "node scripts/build.js",
        "build:terronnd": "cd build-common/src/wasm/terronnd && ./build.sh && wasm-opt -O1 --signext-lowering -o /external/build-321xlr/out/qbitsim-aircraft-a321-253/SimObjects/AirPlanes/A321_XLR/panel/terronnd.wasm /external/build-common/src/wasm/terronnd/out/terronnd_A32NX.wasm",
        "build:tcas": "node build-321xlr/src/systems/tcas/build.js",        
        "prettier": "prettier --write **/*.json **/*.yml build-321xlr/src/systems/instruments/**/*.css",
        "====== INGAMEPANELS CHECKLIST FIX =======================================": "========================================================",
        "build-ingamepanels-checklist-fix:copy-base-package": "mkdir -p qbt-ingamepanels-checklist-fix/out/flybywire-ingamepanels-checklist-fix && (rsync -a qbt-ingamepanels-checklist-fix/src/base/flybywire-ingamepanels-checklist-fix fbw-ingamepanels-checklist-fix/out/ || cp -a -u qbt-ingamepanels-checklist-fix/src/base/flybywire-ingamepanels-checklist-fix qbt-ingamepanels-checklist-fix/out/)",
        "build-ingamepanels-checklist-fix:copy-base-files": "npm run build-ingamepanels-checklist-fix:copy-base-package",
        "build-ingamepanels-checklist-fix:manifest": "node scripts/build_ingamepanels_checklist_fix.js",
        "====== COMMON ===========================================================": "========================================================",
        "lint": "eslint --cache **/*.{js,mjs,jsx,ts,tsx}",
        "lint-fix": "npm run lint -- --fix",
        "test": "vitest run",
        "unchunkLargeFiles": "cd large-files && npm run unchunk",
        "chunkLargeFiles": "cd large-files && npm run chunk"
    },
    "lint-staged": {
        "*.{js,mjs,jsx}": "eslint --cache --fix",
        "*.{json,yml,css,scss}": "prettier --write"
    },
    "devDependencies": {
    "@babel/core": "^7.12.3",
    "@babel/plugin-proposal-class-properties": "~7.12.1",
    "@babel/plugin-transform-runtime": "~7.12.1",
    "@babel/preset-env": "^7.12.1",
    "@babel/preset-react": "^7.12.1",
    "@babel/preset-typescript": "~7.12.7",
    "@flybywiresim/fragmenter": "^0.8.0",
    "@flybywiresim/igniter": "^1.3.0",
    "@flybywiresim/rnp": "^2.1.0",
    "@navigraph/pkce": "^1.0.0",
    "@rollup/plugin-babel": "^5.2.1",
    "@rollup/plugin-commonjs": "^15.1.0",
    "@rollup/plugin-image": "~2.0.6",
    "@rollup/plugin-json": "^4.1.0",
    "@rollup/plugin-node-resolve": "^9.0.0",
    "@rollup/plugin-replace": "^2.3.3",
    "@sentry/types": "^6.17.7",
    "@synaptic-simulations/mach": "^1.0.3",
    "@types/react": "~17.0.11",
    "@types/react-dom": "~17.0.8",
    "@types/react-router-dom": "~5.1.7",
    "@types/semver": "^7.3.13",
    "@typescript-eslint/eslint-plugin": "~6.19.1",
    "@typescript-eslint/parser": "~6.19.1",
    "@vitejs/plugin-react": "^1.2.0",
    "autoprefixer": "^10.4.2",
    "dotenv": "^8.2.0",
    "esbuild": "^0.19.4",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsdoc": "^50.2.3",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-tailwindcss": "^3.17.3",
    "fs-extra": "^10.1.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.5",
    "postcss-color-functional-notation": "^4.2.2",
    "postcss-inset": "^1.0.0",
    "prettier": "^3.2.4",
    "rollup": "^2.66.0",
    "rollup-plugin-copy": "^3.4.0",
    "rollup-plugin-css-only": "^2.1.0",
    "rollup-plugin-livereload": "~2.0.0",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-typescript-paths": "^1.3.0",
    "tailwindcss": "^3.0.24",
    "typescript": "^5.5.0",
    "typescript-strict-plugin": "^2.4.4",
    "vite": "^4.4.9",
    "vite-plugin-filter-replace": "^0.1.14",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.8"
    },
    "dependencies": {
        "@flybywiresim/api-client": "^0.16.2",
        "@flybywiresim/react-components": "^0.3.1",
        "@flybywiresim/tailwind-config": "^0.5.0",
        "@localazy/cli": "^1.6.0",
        "@microsoft/msfs-sdk": "^0.8.0",
        "@react-hook/mouse-position": "~4.1.0",
        "@reduxjs/toolkit": "^1.6.2",
