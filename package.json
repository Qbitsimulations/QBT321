        "@sentry/browser": "^6.17.7",
        "@sentry/integrations": "^6.17.7",
        "@sentry/tracing": "^6.17.7",
        "@tabler/icons": "^1.41.2",
        "@turf/turf": "^7.2.0",
        "@types/react-canvas-draw": "^1.1.1",
        "byte-data": "^19.0.1",
        "classnames": "^2.2.6",
        "esbuild-plugin-inline-image": "^0.0.8",
        "esbuild-style-plugin-v2": "^1.6.5",
        "geolib": "^3.3.3",
        "i18next": "^21.6.14",
        "json5": "^2.2.3",
        "lodash": "^4.17.20",
        "mathjs": "^12.4.3",
        "msfs-geo": "^0.1.0-alpha3",
        "nanoid": "^3.3.1",
